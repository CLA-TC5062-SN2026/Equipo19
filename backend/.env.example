# Copiar a .env y cambiar los valores. .env no se sube al repositorio.

# Base de datos (docker compose)
POSTGRES_DB=sgpis
POSTGRES_USER=sgpis
POSTGRES_PASSWORD=cambiar_esta_contrasena

# Conexión de la API cuando corre fuera de docker (uv run uvicorn ...).
# Dentro de docker compose la arma el servicio api con los valores de arriba.
DATABASE_URL=postgresql+psycopg://sgpis:cambiar_esta_contrasena@localhost:5432/sgpis

# Invitaciones de alta (enlace de un solo uso)
INVITACION_VIGENCIA_HORAS=72
URL_SPA=http://localhost:5173

# Autenticación JWT (S05-S06-A2). Sin estas dos variables /auth/login responde 500.
# JWT_SECRET: secreto HS256 de al menos 32 bytes. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar_por_un_secreto_aleatorio_de_al_menos_32_bytes
# (La API rechaza este valor de ejemplo: hay que reemplazarlo.)
# JWT_EXPIRATION: vida absoluta del token en segundos (entero, 60 a 86400). 28800 = 8 horas.
# Independiente de esto, la sesión expira tras 60 minutos sin actividad.
JWT_EXPIRATION=28800

# Solo desarrollo local (app/semilla.py). Cuenta de Coordinación con la que trabaja la semilla y contraseña de la
# APPI de demostración. Valores de prueba: no usar en ningún servidor.
SEMILLA_CORREO=coordinacion@ampip.local
SEMILLA_CONTRASENA=cambiar-semilla-coordinacion
SEMILLA_APPI_CONTRASENA=cambiar-semilla-appi

# Escenario de demostración del video de S11 (app/demo_s11.py): contraseña de todas las cuentas que crea
# (consultores, APPI de cada parque, gerente corporativo). Solo desarrollo local.
DEMO_CONTRASENA=cambiar-demo-2026

# CORS (S11). URL_SPA (arriba) ya está permitido. Agrega aquí otros orígenes del frontend, separados por coma,
# por ejemplo el dominio donde se despliegue: CORS_ORIGENES=https://sgpis.ejemplo.mx
CORS_ORIGENES=
