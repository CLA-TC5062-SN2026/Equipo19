# Copiar a .env y cambiar los valores. .env no se sube al repositorio.

# Base de datos (docker compose)
POSTGRES_DB=sgpis
POSTGRES_USER=sgpis
POSTGRES_PASSWORD=cambiar_esta_contrasena

# Conexión de la API cuando corre fuera de docker (uv run uvicorn ...).
# Dentro de docker compose la arma el servicio api con los valores de arriba.
DATABASE_URL=postgresql+psycopg://sgpis:cambiar_esta_contrasena@localhost:5432/sgpis

# Invitaciones de alta (enlace de un solo uso)
INVITACION_VIGENCIA_HORAS=72
URL_SPA=http://localhost:5173

# Autenticación JWT (S05-S06-A2). Sin estas dos variables /auth/login responde 500.
# JWT_SECRET: secreto HS256 de al menos 32 bytes. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar_por_un_secreto_aleatorio_de_al_menos_32_bytes
# JWT_EXPIRATION: vida absoluta del token en segundos (entero, 60 a 86400). 28800 = 8 horas.
# Independiente de esto, la sesión expira tras 60 minutos sin actividad.
JWT_EXPIRATION=28800
