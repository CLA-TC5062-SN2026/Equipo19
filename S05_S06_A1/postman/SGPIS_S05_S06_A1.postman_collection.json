{
  "info": {
    "_postman_id": "54fc2a0b-67d7-4b1f-86fe-350da1926f9f",
    "name": "SGPIS S05-S06-A1 CRUD (equipo 19)",
    "description": "Pruebas CRUD de S05-S06-A1. Antes de correrla: base cargada con esquema_bd.sql y `uv run python -m app.semilla`. Desde S05-S06-A2 las rutas exigen token: el primer request inicia sesión con la cuenta de la semilla (coordCorreo, coordContrasena). Correr en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Generaciones (GET 200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/generaciones",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "generaciones"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Desde S05-S06-A2 las rutas exigen token: inicia sesión con la cuenta de Coordinación de la semilla.",
              "pm.sendRequest({url: pm.variables.get('baseUrl') + '/api/auth/login', method: 'POST', header: {'Content-Type': 'application/json'},",
              "  body: {mode: 'raw', raw: JSON.stringify({correo: pm.variables.get('coordCorreo'), contrasena: pm.variables.get('coordContrasena')})}},",
              "  (e, r) => { pm.collectionVariables.set('token', r.json().token); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const g = pm.response.json(); pm.test('hay generación (corre app.semilla)', () => pm.expect(g.length).to.be.above(0));",
              "pm.collectionVariables.set('generacionId', g[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Alta de parque (POST 201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/parques",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "parques"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipoRegistro\": \"activo\",\n  \"nombre\": \"Parque Industrial Demo {{$randomInt}}\",\n  \"desarrollador\": \"Desarrolladora Demo\",\n  \"tipoPI\": \"construccion_cerrado\",\n  \"region\": \"MX-NLE\",\n  \"generacionId\": \"{{generacionId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "const p = pm.response.json(); pm.test('estado activo, fase diagnóstico', () => { pm.expect(p.estado).to.eql('activo'); pm.expect(p.fase).to.eql('diagnostico'); });",
              "pm.collectionVariables.set('parqueId', p.id);"
            ]
          }
        }
      ]
    },
