usuario ||--o{ recomendacion
usuario ||--o{ registro_bitacora
parque ||--o{ registro_bitacora
usuario ||--o{ renglon_plan_trabajo
expediente ||--o{ renglon_plan_trabajo
criterio_parque ||--o{ renglon_plan_trabajo
expediente ||--o{ revision_analisis_riesgos
